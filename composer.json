{
    "name": "paytrail/paytrail-for-woocommerce",
    "type": "wordpress-plugin",
    "description": "Paytrail is a payment gateway that offers 20+ payment methods for Finnish customers.",
    "authors": [{
        "name": "Joonas Loueranta",
        "email": "joonas.loueranta@paytrail.com",
        "homepage": "https://github.com/loueranta-paytrail",
        "role": "Manager"
    }],
    "support": {
        "email": "asiakaspalvelu@paytrail.com",
        "issues": "https://github.com/paytrail/paytrail-for-woocommerce/issues",
        "source": "https://github.com/paytrail/paytrail-for-woocommerce"
    },
    "keywords": [
        "wordpress", "woocommerce", "payment gateway", "paytrail"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": { "Paytrail\\WooCommercePaymentGateway\\": "src/" }
    },
    "require": {
        "php": ">=7.4",
        "ext-mbstring": "*",
        "paytrail/paytrail-php-sdk": "^2.8.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "lint": "vendor/bin/phpcs . --standard=phpcs.xml --extensions=php -q",
        "lint:fix": "vendor/bin/phpcbf . --standard=phpcs.xml --extensions=php -q",
        "lint:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs -r vendor/bin/phpcs --standard=phpcs.xml --extensions=php -q",
        "lint:fix:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs -r vendor/bin/phpcbf --standard=phpcs.xml --extensions=php -q"
    }
}
