# Copy this file to tests/.env and fill in the blanks.
#
# Both files are gitignored. tests/.env is the one Codeception loads (see
# `params:` in codeception.yml).

# ---------------------------------------------------------------------------
# WordPress test install
# ---------------------------------------------------------------------------

# Where the site is served and where Chrome drives it: the built-in server on
# BUILTIN_SERVER_PORT below.
WORDPRESS_URL=http://localhost:5513
BUILTIN_SERVER_PORT=5513

# The public HTTPS URL the tunnel exposes, which NGROK_DOMAIN below must resolve to.
# Only Paytrail uses it; see tests/_mu-plugins/02-paytrail-public-url.php.
PAYTRAIL_WORDPRESS_URL=https://<name>.<subdomain>.ngrok.io

# WPLoader's site domain, which it also boots WordPress with as HTTP_HOST. Keep it
# local: the public host there reads as tunnel traffic in a CLI boot.
WORDPRESS_DOMAIN=localhost

WORDPRESS_DB_URL=sqlite://%codecept_root_dir%/tests/_wordpress/data/db.sqlite
WORDPRESS_TABLE_PREFIX=wp_
TEST_TABLE_PREFIX=test_
WORDPRESS_ROOT_DIR=tests/_wordpress

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=password
WORDPRESS_ADMIN_PATH=/wp-admin

# ---------------------------------------------------------------------------
# Local processes
# ---------------------------------------------------------------------------

CHROMEDRIVER_HOST=127.0.0.1
CHROMEDRIVER_PORT=25469

# ---------------------------------------------------------------------------
# ngrok
# ---------------------------------------------------------------------------

# Value passed to `ngrok http --domain=<this> ...`. Supports custom subdomains using
# the `<name>.internal` format, which is not the public URL; the two are coupled by
# the team ngrok config, and readiness is matched against PAYTRAIL_WORDPRESS_URL.
NGROK_DOMAIN=<name>.internal

# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken.
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------
# Paytrail credentials
# ---------------------------------------------------------------------------
#
# Neither suite needs these: the gateway runs in test mode, where the plugin signs as
# Paytrail's published test merchant. Fill them in only to point a suite at a real
# merchant account. Anything set here is scrubbed out of every test artifact by
# tests/Support/Reporting/SecretRegistry.php.

PAYTRAIL_MERCHANT_ID=
PAYTRAIL_SECRET_KEY=
